# Copy to .env and fill in. .env is git-ignored. Never commit real values.
SSHADMIN_HOST=192.168.56.10
SSHADMIN_USER=labadmin
SSHADMIN_PORT=22
# Preferred: key-based auth
SSHADMIN_KEY_FILE=~/.ssh/id_ed25519
# Optional extra known_hosts file (the system one is always loaded)
# SSHADMIN_KNOWN_HOSTS=~/.ssh/known_hosts
# Fallback only, avoid if you can:
# SSHADMIN_PASSWORD=
